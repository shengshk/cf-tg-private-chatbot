{
	"name": "tg-private-chatbot",
	"main": "worker.js",
	"compatibility_date": "2024-11-30",
	"workers_dev": true,
	"keep_vars": true,
	"kv_namespaces": [
		{
			"binding": "TOPIC_MAP",
			"id": "YOUR_KV_NAMESPACE_ID"
		}
	],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"persist": true,
			"invocation_logs": true
		}
	}
}
